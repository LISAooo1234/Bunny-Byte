provider = "deepseek"
# 主 provider 暂时不可用（5xx / 限流 / 超时）时依次改用的备用 provider
# fallback = ["openai"]

[providers.openai]
protocol = "openai"
api_key = "your-api-key"
base_url = "https://api.openai.com/v1"
model = "gpt-5.4"

[providers.anthropic]
protocol = "anthropic"
api_key = "your-api-key"
base_url = "https://api.anthropic.com"
model = "claude-sonnet-4-6"

[providers.deepseek]
protocol = "anthropic"
api_key = "your-api-key"
base_url = "https://api.deepseek.com/anthropic"
model = "deepseek-v4-pro"

[sandbox]
mode = "off"
backend = "auto"
workspace_write = true
excluded_commands = []

[sandbox.filesystem]
extra_readonly_paths = []
deny_read = []
deny_write = []

[verify]
# 交卷前自动跑项目测试：off | ask（遵循审批策略） | auto
mode = "ask"
# 不写 commands 就按本回合改动的文件自动探测
# commands = ["pytest -q"]
timeout = 120
max_repair_rounds = 1

# 钩子：在固定时机运行你自己的 shell 命令，退出码 2 表示拦截/反馈。说明见 docs/hooks.md。
# 仓库里的钩子要先在会话里 /hooks trust 才会运行。
# [[hooks.pre_tool]]
# match = "write_file|patch_file"
# command = "python3 .bunnybyte/hooks/guard.py"
# on_error = "block"
#
# [[hooks.post_tool]]
# match = "write_file|patch_file"
# command = "ruff format --quiet . && ruff check --quiet . || exit 2"
#
# [[hooks.on_final]]
# command = "python3 .bunnybyte/hooks/before_done.py"
# only_if_changed = true
